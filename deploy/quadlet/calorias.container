[Unit]
Description=Calorías - aplicación Next.js
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=calorias
Image=localhost/calorias:current
Pull=never
PublishPort=127.0.0.1:3090:3000
EnvironmentFile=/etc/calorias/app.env
Environment=TZ=Europe/Madrid
Volume=/var/lib/calorias/data:/data:rw,z
User=10002
Group=10002
RunInit=true
ReadOnly=true
ReadOnlyTmpfs=true
# Podman activa tmpcopyup por defecto. El cache de build de Next.js puede
# superar este limite; el cache de runtime debe empezar vacio.
Tmpfs=/app/.next/cache:rw,size=64m,mode=1777,notmpcopyup
NoNewPrivileges=true
DropCapability=all
HealthCmd=node /usr/local/bin/calorias-healthcheck.mjs
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill
LogDriver=k8s-file
# Compatibilidad con los generadores Quadlet 4.9/5.0 de Ubuntu.
PodmanArgs=--log-opt=max-size=20mb --stop-signal=SIGTERM --stop-timeout=30
PidsLimit=256

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
