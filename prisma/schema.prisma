generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppUser {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One line of the food diary. Name and kcal are copies taken when the entry
// is saved, so editing a food later never rewrites past days.
model DiaryEntry {
  id        String   @id @default(cuid())
  day       String // YYYY-MM-DD in Europe/Madrid
  meal      String // breakfast | midMorning | lunch | afternoonSnack | dinner | snack
  name      String?
  quantity  Float?
  unit      String? // g | ml | portion name
  kcal      Int
  foodId    String?
  food      Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  source    String   @default("manual") // manual | library | barcode | text | label
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
  @@index([foodId])
}

// The single user's data for the calorie target. Only one row exists.
model Profile {
  id               String   @id @default("profile")
  sex              String // female | male
  birthDate        String // YYYY-MM-DD
  heightCm         Float
  activity         String // sedentary | light | moderate | active | veryActive
  targetWeightKg   Float
  pace             String // maintain | gentle | moderate | fast
  manualTargetKcal Int? // overrides the calculated target when set
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// One weigh-in per day. The calorie target uses their trend
// (src/domain/weight.ts), not the last value.
model WeightEntry {
  id        String   @id @default(cuid())
  day       String   @unique // YYYY-MM-DD in Europe/Madrid
  kg        Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A food of the library. Energy is per 100 of its base unit (g or ml);
// portions are named amounts of that unit. Macros are stored, never shown.
model Food {
  id            String        @id @default(cuid())
  name          String
  brand         String?
  barcode       String?       @unique
  baseUnit      String // g | ml
  kcalPer100    Float
  proteinPer100 Float?
  carbsPer100   Float?
  fatPer100     Float?
  imageUrl      String? // product photo of Open Food Facts
  source        String        @default("manual") // manual | barcode | text | label
  favorite      Boolean       @default(false)
  archived      Boolean       @default(false)
  lastUsedAt    DateTime?
  portions      FoodPortion[]
  entries       DiaryEntry[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// "1 rebanada = 30 g": amount is in the food's base unit.
model FoodPortion {
  id       String @id @default(cuid())
  foodId   String
  food     Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  name     String
  amount   Float
  position Int    @default(0)

  @@index([foodId])
}

// One request to the Claude API, to show the month's estimated spend.
model AiCall {
  id           String   @id @default(cuid())
  day          String // YYYY-MM-DD in Europe/Madrid
  kind         String // text | label
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float? // null when the model's price is unknown
  durationMs   Int
  ok           Boolean
  createdAt    DateTime @default(now())

  @@index([day])
}

// A day the user marked as complete or incomplete, overriding the automatic
// rule (a day with very few kcal counts as incomplete). Incomplete days are
// left out of the summary and of the real expenditure estimate.
model DiaryDay {
  day       String   @id // YYYY-MM-DD in Europe/Madrid
  status    String // complete | incomplete
  updatedAt DateTime @updatedAt
}

// The weekly check-in: the real expenditure estimated from intake and the
// weight trend, and the target it proposed. The latest accepted one sets
// the expenditure the target is calculated from (src/domain/adaptive.ts).
model WeeklyCheckIn {
  id             String   @id @default(cuid())
  weekStart      String   @unique // Monday YYYY-MM-DD; data up to the day before
  intakeKcal     Int // average of the counted days of the window
  countedDays    Int
  trendChangeKg  Float // trend change over weightSpanDays (negative: lost)
  weightSpanDays Int
  rawTdee        Int // before smoothing
  estimatedTdee  Int
  previousTarget Int
  proposedTarget Int
  accepted       Boolean
  createdAt      DateTime @default(now())
}
