generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppUser {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One line of the food diary. Name and kcal are copies taken when the entry
// is saved, so editing a food later never rewrites past days.
model DiaryEntry {
  id        String   @id @default(cuid())
  day       String // YYYY-MM-DD in Europe/Madrid
  meal      String // breakfast | midMorning | lunch | afternoonSnack | dinner | snack
  name      String?
  quantity  Float?
  unit      String? // g | ml | portion name
  kcal      Int
  foodId    String? // Food arrives in phase 5; no relation until then
  source    String   @default("manual") // manual | library | barcode | text | label
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
}

// The single user's data for the calorie target. Only one row exists.
model Profile {
  id               String   @id @default("profile")
  sex              String // female | male
  birthDate        String // YYYY-MM-DD
  heightCm         Float
  activity         String // sedentary | light | moderate | active | veryActive
  targetWeightKg   Float
  pace             String // maintain | gentle | moderate | fast
  manualTargetKcal Int? // overrides the calculated target when set
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// One weigh-in per day. Phase 3 only stores the starting weight and the
// weight entered in the profile; phase 4 adds the history and the trend.
model WeightEntry {
  id        String   @id @default(cuid())
  day       String   @unique // YYYY-MM-DD in Europe/Madrid
  kg        Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
